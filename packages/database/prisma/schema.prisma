  title      String
  url        String
  icon       String?
  isExternal Boolean  @default(false) @map("is_external")
  isVisible  Boolean  @default(true) @map("is_visible")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  menu     NavigationMenu  @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent   NavigationItem? @relation("NavItemHierarchy", fields: [parentId], references: [id])
  children NavigationItem[] @relation("NavItemHierarchy")

  @@index([menuId])
  @@index([parentId])
  @@map("navigation_items")
}

// ============================================================
// CMS: Mortgage Banks
// ============================================================

model MortgageBank {
  id        Int      @id @default(autoincrement())
  name      String
  rateFrom  Decimal? @map("rate_from") @db.Decimal(5, 2)
  rateTo    Decimal? @map("rate_to") @db.Decimal(5, 2)
  logoUrl   String?  @map("logo_url")
  url       String?
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("mortgage_banks")
}

// ============================================================
// Audit
// ============================================================

model AuditEvent {
  id         BigInt      @id @default(autoincrement())
  userId     String?     @map("user_id") @db.Uuid
  entityType String      @map("entity_type")
  entityId   Int         @map("entity_id")
  action     AuditAction
  oldData    Json?       @map("old_data")
  newData    Json?       @map("new_data")
  ipAddress  String?     @map("ip_address")
  createdAt  DateTime    @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_events")
}
