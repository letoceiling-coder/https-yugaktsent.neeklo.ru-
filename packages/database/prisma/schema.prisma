  amountRub        Int                  @map("amount_rub")
  status           PromotionOrderStatus @default(PENDING)
  invoiceId        String?              @map("invoice_id") @db.Uuid
  fulfilledAt      DateTime?            @map("fulfilled_at")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  billingAccount BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)
  listing        Listing        @relation(fields: [listingId], references: [id], onDelete: Cascade)
  invoice        Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([billingAccountId])
  @@index([listingId])
  @@index([status])
  @@index([invoiceId])
  @@map("promotion_orders")
}

