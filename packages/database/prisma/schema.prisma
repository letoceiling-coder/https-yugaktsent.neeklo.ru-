generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Enums
// ============================================================

enum UserRole {
  admin
  editor
  manager
  agent
  client
}

enum CollectionItemKind {
  BLOCK
  LISTING
}

enum DataSource {
  FEED
  MANUAL
}

enum ListingKind {
  APARTMENT
  PARKING
  LAND
  COMMERCIAL
  HOUSE
}

enum ListingStatus {
  ACTIVE
  SOLD
  RESERVED
  DRAFT
  INACTIVE
}

/// Iter 44 — marketplace visibility (separate from operational status)
/// Iter 50 — REVIEW/REJECTED for moderation workflow
enum ListingVisibility {
  PUBLIC
  HIDDEN
  ARCHIVED
  DRAFT
  REVIEW
  REJECTED
}

/// Iter 53 — marketplace promotion tier (monetization layer)
enum ListingPromotionTier {
  STANDARD
  VIP
  BOOSTED
  PREMIUM
}

/// Iter 20 — listing geo provenance (nullable until normalization; no UI_ONLY)
enum GeoSource {
  MANUAL_EXACT
  FEED_EXACT
  BUILDING_INHERIT
  BLOCK_INHERIT
  GEOCODE_VERIFIED
  GEOCODE_APPROXIMATE
  UNKNOWN
}

/// Iter 20 — Iter 17 tier subset persisted on listing row
enum GeoQuality {
  EXACT
  BUILDING_CENTROID
  BLOCK_CENTROID
  MISSING
  INVALID
}

/// Inherit entity pointer — BUILDING | BLOCK only (EXACT uses null)
enum GeoEntityKind {
  BUILDING
  BLOCK
}

/// Iter 22 — human review governance (separate from geo_source; no auto-classification)
enum ListingGeoReviewStatus {
  PENDING_REVIEW
  APPROVED_AS_EXACT
  APPROVED_AS_BUILDING
  APPROVED_AS_BLOCK
  MARKED_INVALID
  SKIPPED
}

/// Новостройка vs вторичка (только объявления kind=APARTMENT)
enum ApartmentMarketSegment {
  NEW_BUILDING
  SECONDARY
}

enum BlockStatus {
  BUILDING
  COMPLETED
  PROJECT
}

enum BlockImageKind {
  RENDER
  PLAN
}

enum MediaKind {
  PHOTO
  PLAN
  RENDER
  DOCUMENT
}

enum ImportBatchStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

enum RequestStatus {
  NEW
  IN_PROGRESS
  CONTACTED
  VIEWING_SCHEDULED
  NEGOTIATION
  SUCCESS
  CLOSED
  SPAM
  /** @deprecated use SUCCESS */
  COMPLETED
  /** @deprecated use CLOSED */
  CANCELLED
}

enum RequestEventType {
  CREATED
  ASSIGNED
  STATUS_CHANGED
  NOTE_ADDED
  CONTACTED
  VIEWING_SCHEDULED
}

enum CrmNotificationType {
  NEW_ASSIGNED_LEAD
  OVERDUE_LEAD
  STALE_LEAD
  NEW_NOTE
  STATUS_CHANGED
  VIEWING_REMINDER
  REASSIGNED
  TG_CLAIMED
  BUYER_REPLY
  CALLBACK_OVERDUE
  MANAGER_MENTIONED
  UNREAD_CONVERSATION
  FOLLOWUP_DUE
  ESCALATION_ASSIGNED
  STALE_RESCUE_TRIGGERED
}

enum CrmThreadType {
  LISTING_INQUIRY
  COMPLEX_INQUIRY
  SUPPORT
  INTERNAL
}

enum CrmMessageType {
  TEXT
  SYSTEM
  NOTE
  CONTACT_ATTEMPT
  CALLBACK_SCHEDULED
}

enum CrmMessageVisibility {
  INTERNAL
  BUYER_VISIBLE
  MANAGER_ONLY
}

enum CrmParticipantRole {
  BUYER
  AGENT
  MANAGER
  SYSTEM
}

enum CrmNotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum CrmAutomationRuleType {
  CALLBACK_OVERDUE
  STALE_NEGOTIATION
  NO_REPLY
  REOPEN_RISK
  NEW_VIP_INQUIRY
  SAVED_SEARCH_HOT_LEAD
}

enum CrmFollowupTaskType {
  CALL_CLIENT
  SEND_REMINDER
  REVISIT_STALE
  ESCALATE_NEGOTIATION
  SCHEDULE_VIEWING
  RESCUE_REOPEN
}

enum CrmFollowupTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  DISMISSED
  EXPIRED
}

enum CrmAutomationActionKind {
  CREATE_TASK
  NOTIFY
  ESCALATE
}

enum CrmSnapshotKind {
  GLOBAL_OPS
  FUNNEL
  SLA
  BEHAVIOR
  MANAGERS
  SOURCE_ATTRIBUTION
  OBJECT_PRESSURE
  PIPELINE_VELOCITY
  LIFECYCLE_FRICTION
  CONVERSION_QUALITY
  RECOVERY_INTELLIGENCE
  FORECAST_SIGNALS
  CAPACITY_PRESSURE
}

enum RequestType {
  CONSULTATION
  MORTGAGE
  CALLBACK
  SELECTION
  CONTACT
}

enum TelegramNotifyAccessStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ParkingType {
  UNDERGROUND
  GROUND
  MULTILEVEL
}

enum CommercialType {
  OFFICE
  RETAIL
  WAREHOUSE
  RESTAURANT
  OTHER
}

enum HouseType {
  DETACHED
  SEMI
  TOWNHOUSE
  DUPLEX
}

enum SiteSettingFieldType {
  TEXT
  TEXTAREA
  URL
  PHONE
  EMAIL
  IMAGE
  BOOLEAN
  /// Секрет (токен и т.п.): только админ, не отдаётся в публичном GET /content/settings
  SECRET
}

enum NewsWorkflowStatus {
  NEW
  REWRITTEN
  DRAFT
  PUBLISHED
  ERROR

  @@map("news_workflow_status")
}

enum AiProviderKind {
  OPENAI
  OPENROUTER
  GEMINI
  CLAUDE

  @@map("ai_provider_kind")
}

enum ContentFieldType {
  TEXT
  TEXTAREA
  RICHTEXT
  NUMBER
  URL
  IMAGE
  BOOLEAN
  JSON_ARRAY
}

enum ContentItemFieldType {
  TEXT
  TEXTAREA
  URL
  IMAGE
  NUMBER
  BOOLEAN
}

// ============================================================
// Users & Sessions
// ============================================================

model User {
  id               String    @id @default(uuid()) @db.Uuid
  email            String?   @unique
  phone            String?   @unique
  passwordHash     String?   @map("password_hash")
  fullName         String?   @map("full_name")
  avatarUrl        String?   @map("avatar_url")
  role             UserRole  @default(client)
  telegramId       BigInt?   @unique @map("telegram_id")
  telegramUsername  String?   @map("telegram_username")
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  sessions         Session[]
  auditEvents      AuditEvent[]
  importBatches    ImportBatch[]   @relation("TriggeredImports")
  fieldOverrides   FieldOverride[]
  mediaFiles       MediaFile[]
  siteSettings     SiteSetting[]   @relation("UpdatedSettings")
  contentBlocks    ContentBlock[]  @relation("UpdatedBlocks")
  assignedRequests   Request[]       @relation("AssignedRequests")
  submittedRequests  Request[]       @relation("SubmittedRequests")
  requestEvents      RequestEvent[]  @relation("RequestEventActor")
  crmNotificationsReceived CrmNotification[] @relation("CrmNotificationRecipient")
  crmNotificationsActed    CrmNotification[] @relation("CrmNotificationActor")
  crmThreadsAsBuyer        CrmThread[]       @relation("CrmThreadBuyer")
  crmThreadParticipants    CrmThreadParticipant[] @relation("CrmThreadParticipantUser")
  crmMessagesAuthored        CrmMessage[]      @relation("CrmMessageActor")
  crmAutomationActions       CrmAutomationAction[] @relation("CrmAutomationActionAssignee")
  crmFollowupTasksAssigned   CrmFollowupTask[] @relation("CrmFollowupTaskAssignee")
  crmFollowupTasksCompleted  CrmFollowupTask[] @relation("CrmFollowupTaskCompleter")
  reviewedTelegramRequests TelegramNotifyAccessRequest[] @relation("ReviewedTelegramRequests")
  approvedTelegramRecipients TelegramNotifyRecipient[] @relation("ApprovedTelegramRecipients")
  favorites          Favorite[]
  collections      UserCollection[]
  savedSearches    SavedSearch[]
  userNotifications UserNotification[]
  browseHistory    UserBrowseHistory[]
  telegramAuthCodes TelegramAuthCode[]
  createdSellers    Seller[] @relation("SellerCreatedBy")
  updatedSellers    Seller[] @relation("SellerUpdatedBy")
  ownedListings     Listing[] @relation("ListingOwner")
  wizardSnapshotsUpdated ListingWizardSnapshot[] @relation("WizardSnapshotEditor")
  listingEditHistory ListingEditHistory[] @relation("ListingEditActor")
  agentTrustScore    AgentTrustScore?
  agencyVerification AgencyVerification?
  listingFlags       ListingFlag[]
  verifiedAgencies   AgencyVerification[] @relation("AgencyVerifier")
  billingAccount     BillingAccount?
  agencyProfile      AgencyProfile?
  agentProfile       AgentProfile?

  @@map("users")
}


model TelegramAuthCode {
  id        Int       @id @default(autoincrement())
  userId    String    @map("user_id") @db.Uuid
  code      String    @db.VarChar(6)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([code])
  @@index([expiresAt])
  @@index([usedAt])
  @@map("telegram_auth_codes")
}

model Session {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  refreshTokenHash String   @map("refresh_token_hash")
  expiresAt        DateTime @map("expires_at")
  createdAt        DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// ============================================================
// Regions & Geography
// ============================================================

model FeedRegion {
  id             Int       @id @default(autoincrement())
  code           String    @unique
  name           String
  baseUrl        String?   @map("base_url")
  /// Публичный URL витрины для региона (поддомен/отдельный домен); иначе используется глобальный PUBLIC_SITE_URL
  publicSiteUrl  String?   @map("public_site_url")
  mapCenterLat   Decimal?  @map("map_center_lat") @db.Decimal(10, 8)
  mapCenterLng   Decimal?  @map("map_center_lng") @db.Decimal(11, 8)
  isEnabled      Boolean   @default(false) @map("is_enabled")
  lastImportedAt DateTime? @map("last_imported_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  districts     District[]
  subways       Subway[]
  builders      Builder[]
  blocks        Block[]
  buildings     Building[]
  listings      Listing[]
  importBatches ImportBatch[]
  news          News[]
  telegramNewsChannels NewsTelegramChannel[]
  savedSearches SavedSearch[]
  feedLinks     FeedLink[]

  @@map("feed_regions")
}

model FeedLink {
  id           Int       @id @default(autoincrement())
  regionId     Int       @map("region_id")
  name         String
  feedUrl      String    @map("feed_url")
  blockName    String?   @map("block_name")
  provider     String    @default("profitbase")
  isEnabled    Boolean   @default(true) @map("is_enabled")
  sortOrder    Int       @default(0) @map("sort_order")
  lastSyncedAt DateTime? @map("last_synced_at")
  lastSyncStatus String?   @map("last_sync_status")
  lastSyncTotal  Int?      @map("last_sync_total")
  lastSyncCreated Int?     @map("last_sync_created")
  lastSyncUpdated Int?     @map("last_sync_updated")
  lastSyncErrors Int?      @map("last_sync_errors")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  region FeedRegion @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@unique([feedUrl])
  @@index([regionId, isEnabled])
  @@map("feed_links")
}

model District {
  id         Int      @id @default(autoincrement())
  regionId   Int      @map("region_id")
  externalId String?  @map("external_id")
  crmId      BigInt?  @map("crm_id")
  name       String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  region   FeedRegion @relation(fields: [regionId], references: [id])
  blocks   Block[]
  listings Listing[]

  @@unique([regionId, externalId])
  @@map("districts")
}

model Subway {
  id         Int      @id @default(autoincrement())
  regionId   Int      @map("region_id")
  externalId String?  @map("external_id")
  crmId      BigInt?  @map("crm_id")
  name       String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  region      FeedRegion   @relation(fields: [regionId], references: [id])
  blockSubways BlockSubway[]

  @@unique([regionId, externalId])
  @@map("subways")
}

// ============================================================
// Builders
// ============================================================

model Builder {
  id         Int        @id @default(autoincrement())
  regionId   Int        @map("region_id")
  externalId String?    @map("external_id")
  crmId      BigInt?    @map("crm_id")
  name       String
  dataSource DataSource @default(FEED) @map("data_source")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  region   FeedRegion @relation(fields: [regionId], references: [id])
  blocks   Block[]
  listings Listing[]

  @@unique([regionId, externalId])
  @@map("builders")
}

// ============================================================
// Reference tables
// ============================================================

model RoomType {
  id         Int     @id @default(autoincrement())
  externalId String? @unique @map("external_id")
  crmId      BigInt? @map("crm_id")
  name       String
  nameOne    String? @map("name_one")

  apartments ListingApartment[]

  @@map("room_types")
}

model Finishing {
  id         Int     @id @default(autoincrement())
  externalId String? @unique @map("external_id")
  crmId      BigInt? @map("crm_id")
  name       String

  apartments ListingApartment[]

  @@map("finishings")
}

model BuildingType {
  id         Int     @id @default(autoincrement())
  externalId String? @unique @map("external_id")
  crmId      BigInt? @map("crm_id")
  name       String

  buildings  Building[]
  apartments ListingApartment[]

  @@map("building_types")
}

// ============================================================
// Blocks (ЖК)
// ============================================================

model Block {
  id             Int         @id @default(autoincrement())
  regionId       Int         @map("region_id")
  externalId     String?     @map("external_id")
  crmId          BigInt?     @map("crm_id")
  slug           String      @unique
  name           String
  description    String?     @db.Text
  districtId     Int?        @map("district_id")
  builderId      Int?        @map("builder_id")
  status         BlockStatus @default(BUILDING)
  latitude       Decimal?    @db.Decimal(10, 8)
  longitude      Decimal?    @db.Decimal(11, 8)
  isPromoted     Boolean     @default(false) @map("is_promoted")
  salesStartDate DateTime?   @map("sales_start_date") @db.Date
  /** Список инфраструктуры (POI вокруг ЖК) — массив строк или объектов { name, distance, type }. */
  infrastructure Json?       @map("infrastructure")
  dataSource     DataSource  @default(FEED) @map("data_source")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  region    FeedRegion    @relation(fields: [regionId], references: [id])
  district  District?     @relation(fields: [districtId], references: [id])
  builder   Builder?      @relation(fields: [builderId], references: [id])
  addresses BlockAddress[]
  images    BlockImage[]
  subways   BlockSubway[]
  buildings Building[]
  listings  Listing[]
  favorites Favorite[]

  @@unique([regionId, externalId])
  @@map("blocks")
}

model BlockAddress {
  id        Int    @id @default(autoincrement())
  blockId   Int    @map("block_id")
  address   String
  sortOrder Int    @default(0) @map("sort_order")

  block Block @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@map("block_addresses")
}

model BlockImage {
  id        Int            @id @default(autoincrement())
  blockId   Int            @map("block_id")
  url       String
  kind      BlockImageKind
  sortOrder Int            @default(0) @map("sort_order")

  block Block @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@map("block_images")
}

model BlockSubway {
  id           Int   @id @default(autoincrement())
  blockId      Int   @map("block_id")
  subwayId     Int   @map("subway_id")
  distanceTime Int?  @map("distance_time")
  distanceType Int?  @map("distance_type") @db.SmallInt

  block  Block  @relation(fields: [blockId], references: [id], onDelete: Cascade)
  subway Subway @relation(fields: [subwayId], references: [id])

  @@unique([blockId, subwayId, distanceType])
  @@map("block_subways")
}

// ============================================================
// Buildings (Корпуса)
// ============================================================

model Building {
  id             Int        @id @default(autoincrement())
  regionId       Int        @map("region_id")
  blockId        Int        @map("block_id")
  externalId     String?    @map("external_id")
  crmId          BigInt?    @map("crm_id")
  name           String?
  queue          String?
  buildingTypeId Int?       @map("building_type_id")
  deadline       DateTime?  @db.Date
  deadlineKey    DateTime?  @map("deadline_key") @db.Date
  subsidy        Boolean    @default(false)
  latitude       Decimal?   @db.Decimal(10, 8)
  longitude      Decimal?   @db.Decimal(11, 8)
  dataSource     DataSource @default(FEED) @map("data_source")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  region       FeedRegion        @relation(fields: [regionId], references: [id])
  block        Block             @relation(fields: [blockId], references: [id])
  buildingType BuildingType?     @relation(fields: [buildingTypeId], references: [id])
  addresses    BuildingAddress[]
  listings     Listing[]

  @@unique([regionId, externalId])
  @@index([blockId])
  @@map("buildings")
}

model BuildingAddress {
  id         Int     @id @default(autoincrement())
  buildingId Int     @map("building_id")
  street     String?
  house      String?
  housing    String?
  streetEn   String? @map("street_en")
  houseEn    String? @map("house_en")
  housingEn  String? @map("housing_en")

  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@map("building_addresses")
}

// ============================================================
// Listings (universal)
// ============================================================

model Listing {
  id         Int           @id @default(autoincrement())
  regionId   Int           @map("region_id")
  kind       ListingKind
  blockId    Int?          @map("block_id")
  buildingId Int?          @map("building_id")
  builderId  Int?          @map("builder_id")
  districtId Int?          @map("district_id")
  externalId String?       @map("external_id")
  crmId      BigInt?       @map("crm_id")
  price      Decimal?      @db.Decimal(15, 2)
  priceBase  Decimal?      @map("price_base") @db.Decimal(15, 2)
  currency   String        @default("RUB") @db.VarChar(3)
  status     ListingStatus @default(ACTIVE)
  dataSource DataSource    @default(FEED) @map("data_source")
  visibility ListingVisibility @default(PUBLIC)
  isPublished Boolean      @default(true) @map("is_published")
  isHot       Boolean      @default(false) @map("is_hot")
  promotionTier   ListingPromotionTier @default(STANDARD) @map("promotion_tier")
  promotedUntil   DateTime?  @map("promoted_until")
  boostScore      Int        @default(0) @map("boost_score")
  vipPriority     Int        @default(0) @map("vip_priority")
  publishedAt DateTime?    @map("published_at")
  archivedAt  DateTime?    @map("archived_at")
  lastActivityAt DateTime? @map("last_activity_at")
  ownerUserId String?       @map("owner_user_id") @db.Uuid
  moderationNote String?    @map("moderation_note") @db.Text
  draftVersion   Int         @default(1) @map("draft_version")
  title       String?       @db.Text
  address     String?       @db.Text
  description String?       @db.Text
  sourceUrl   String?       @map("source_url") @db.Text
  sellerId    Int?          @map("seller_id")
  lat         Decimal?      @db.Decimal(10, 8)
  lng         Decimal?      @db.Decimal(11, 8)
  geoSource            GeoSource?     @map("geo_source")
  geoQuality           GeoQuality?    @map("geo_quality")
  geoConfidence        Decimal?       @map("geo_confidence") @db.Decimal(4, 3)
  geoResolvedAt        DateTime?      @map("geo_resolved_at") @db.Timestamptz(3)
  geoEntityId          Int?           @map("geo_entity_id")
  geoEntityKind        GeoEntityKind? @map("geo_entity_kind")
  geoResolutionVersion Int?           @map("geo_resolution_version")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  region    FeedRegion @relation(fields: [regionId], references: [id])
  block     Block?     @relation(fields: [blockId], references: [id])
  building  Building?  @relation(fields: [buildingId], references: [id])
  builder   Builder?   @relation(fields: [builderId], references: [id])
  district  District?  @relation(fields: [districtId], references: [id])
  seller    Seller?    @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  ownerUser User?      @relation("ListingOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  apartment  ListingApartment?
  parking    ListingParking?
  land       ListingLand?
  commercial ListingCommercial?
  house      ListingHouse?
  favorites  Favorite[]
  geoReviewDecisions ListingGeoReviewDecision[]
  geoMaterializationSnapshots ListingGeoMaterializationSnapshot[]
  wizardSnapshot ListingWizardSnapshot?
  editHistory    ListingEditHistory[]
  trustScore     ListingTrustScore?
  trustFlags     ListingFlag[]
  promotionOrders PromotionOrder[]

  @@unique([regionId, externalId])
  @@index([regionId, kind])
  @@index([regionId, price])
  @@index([regionId, districtId])
  @@index([blockId])
  @@index([buildingId])
  @@index([builderId])
  @@index([sellerId])
  @@index([status])
  @@index([dataSource])
  @@index([visibility])
  @@index([ownerUserId])
  @@index([lastActivityAt])
  @@index([promotionTier, promotedUntil])
  @@index([vipPriority])
  @@index([geoQuality, regionId])
  @@index([geoSource])
  @@index([geoEntityKind, geoEntityId])
  @@map("listings")
}

/// Iter 22 — immutable append-only human review decisions (no listing geo writes)
model ListingGeoReviewDecision {
  id             Int                     @id @default(autoincrement())
  listingId      Int                     @map("listing_id")
  reviewStatus   ListingGeoReviewStatus  @map("review_status")
  reviewer       String                  @db.VarChar(128)
  decisionReason String?                 @map("decision_reason") @db.Text
  beforeLat      Decimal?                @map("before_lat") @db.Decimal(10, 8)
  beforeLng      Decimal?                @map("before_lng") @db.Decimal(11, 8)
  proposedLat    Decimal?                @map("proposed_lat") @db.Decimal(10, 8)
  proposedLng    Decimal?                @map("proposed_lng") @db.Decimal(11, 8)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, createdAt(sort: Desc)])
  @@index([reviewStatus])
  @@map("listing_geo_review_decisions")
}

/// Iter 23 — pre-materialization snapshots for staging rollback
model ListingGeoMaterializationSnapshot {
  id                         Int            @id @default(autoincrement())
  runId                      String         @map("run_id") @db.VarChar(36)
  listingId                  Int            @map("listing_id")
  beforeLat                  Decimal?       @map("before_lat") @db.Decimal(10, 8)
  beforeLng                  Decimal?       @map("before_lng") @db.Decimal(11, 8)
  beforeGeoSource            GeoSource?     @map("before_geo_source")
  beforeGeoQuality           GeoQuality?    @map("before_geo_quality")
  beforeGeoConfidence        Decimal?       @map("before_geo_confidence") @db.Decimal(4, 3)
  beforeGeoEntityId          Int?           @map("before_geo_entity_id")
  beforeGeoEntityKind        GeoEntityKind? @map("before_geo_entity_kind")
  beforeGeoResolutionVersion Int?           @map("before_geo_resolution_version")
  beforeGeoResolvedAt        DateTime?      @map("before_geo_resolved_at") @db.Timestamptz(3)
  afterLat                   Decimal?       @map("after_lat") @db.Decimal(10, 8)
  afterLng                   Decimal?       @map("after_lng") @db.Decimal(11, 8)
  afterGeoSource             GeoSource?     @map("after_geo_source")
  afterGeoQuality            GeoQuality?    @map("after_geo_quality")
  createdAt                  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([listingId])
  @@map("listing_geo_materialization_snapshots")
}

