  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  billingAccount BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)

  @@index([billingAccountId])
  @@index([status])
  @@map("subscriptions")
}

model Invoice {
  id               String        @id @default(uuid()) @db.Uuid
  billingAccountId String        @map("billing_account_id") @db.Uuid
  number           String        @unique @db.VarChar(32)
  status           InvoiceStatus @default(DRAFT)
  amountRub        Int           @map("amount_rub")
  currency         String        @default("RUB") @db.VarChar(3)
  dueAt            DateTime      @map("due_at")
  paidAt           DateTime?     @map("paid_at")
  lineItemsJson    Json          @default("[]") @map("line_items_json")
  notes            String?       @db.Text
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  billingAccount  BillingAccount   @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)
  promotionOrders PromotionOrder[]

  @@index([billingAccountId])
  @@index([status])
  @@index([dueAt])
  @@map("invoices")
}

model UsageEvent {
  id               String         @id @default(uuid()) @db.Uuid
  billingAccountId String         @map("billing_account_id") @db.Uuid
  kind             UsageEventKind
  quantity         Int            @default(1)
