  uploadedBy         String?   @map("uploaded_by") @db.Uuid
  folderId           Int?      @map("folder_id")
  previousFolderId   Int?      @map("previous_folder_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  user             User?        @relation(fields: [uploadedBy], references: [id])
  folder           MediaFolder? @relation("MediaFileFolder", fields: [folderId], references: [id], onDelete: SetNull)
  previousFolder   MediaFolder? @relation("MediaFilePreviousFolder", fields: [previousFolderId], references: [id], onDelete: SetNull)

  @@index([folderId])
  @@map("media_files")
}

