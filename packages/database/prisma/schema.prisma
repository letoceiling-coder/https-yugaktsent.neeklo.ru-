model MediaFolder {
  id        Int      @id @default(autoincrement())
  parentId  Int?     @map("parent_id")
  name      String   @db.VarChar(255)
  isTrash   Boolean  @default(false) @map("is_trash")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent            MediaFolder?  @relation("MediaFolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children          MediaFolder[] @relation("MediaFolderChildren")
  files             MediaFile[]   @relation("MediaFileFolder")
  previousForFiles  MediaFile[]   @relation("MediaFilePreviousFolder")

  @@unique([parentId, name])
  @@map("media_folders")
}

model MediaFile {
  id                 Int       @id @default(autoincrement())
  entityType         String?   @map("entity_type")
