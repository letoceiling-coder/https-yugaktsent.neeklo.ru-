# yugaktsent.neeklo.ru — отдельный инстанс LiveGrid (без TrendAgent)

# === Database ===
DATABASE_URL=postgresql://yugaktsent_lg:CHANGE_ME@127.0.0.1:5432/yugaktsent_lg

# === Redis (botmate-redis на этом сервере) ===
REDIS_URL=redis://127.0.0.1:6379

# === JWT (сгенерировать уникальные секреты!) ===
JWT_ACCESS_SECRET=change-me-yugaktsent-access-min-32-chars
JWT_REFRESH_SECRET=change-me-yugaktsent-refresh-min-32-chars

# === API ===
API_PORT=3025
API_PREFIX=/api/v1
PUBLIC_SITE_URL=https://yugaktsent.neeklo.ru
CORS_ORIGINS=https://yugaktsent.neeklo.ru,http://localhost:5173

# === TrendAgent — ОТКЛЮЧЕНО ===
TRENDAGENT_BASE_URL=
TRENDAGENT_DEFAULT_REGION=
TRENDAGENT_REGIONS=
FEED_IMPORT_DISABLE_REPEAT=true
FEED_IMPORT_PROCESSOR_ENABLED=false
FEED_HTTP_FETCH_ALLOWED=false

# === Media ===
MEDIA_ROOT=/srv/yugaktsent-lg/uploads

# === Profitbase sync (PM2 yugaktsent-profitbase-sync) ===
LG_API_BASE=http://127.0.0.1:3025/api/v1
LG_ADMIN_EMAIL=admin@livegrid.ru
LG_ADMIN_PASSWORD=admin123!
PROFITBASE_CRON='0 */6 * * *'
FEED_SKIP_MEDIA=false
# JSON-массив фидов Profitbase (Николай 1 + Граф Толстой + Хозяин Морей):
FEEDS_JSON='[{"name":"Николай 1","feed_url":"https://pb19399.profitbase.ru/export/profitbase_xml/358ecc7d3e87ba79bd1caf91506ee1b5?scheme=https","block_name":"Николай 1 Hotel&Spa"},{"name":"Граф Толстой","feed_url":"https://pb19399.profitbase.ru/export/profitbase_xml/d4fce6f54ec060162ca1c772a7613dcc?scheme=https","block_name":"Граф Толстой"},{"name":"Хозяин Морей","feed_url":"https://pb16100.tochno.profitbase.ru/export/profitbase_xml/b0e4c95d324cf97e540324cec236aea0?scheme=https","block_name":"ЖК Хозяин Морей"}]'

VITE_DEFAULT_REGION_CODE=anapa
VITE_DEFAULT_BRAND=ЮгАкцент
YUGAKTSENT_REGION_CODE=anapa
YUGAKTSENT_REGION_NAME=Анапа
YUGAKTSENT_MAP_LAT=44.895
YUGAKTSENT_MAP_LNG=37.3163

# === Optional encryption key for AI settings ===
AI_SETTINGS_ENCRYPTION_KEY=
