[Unit]
Description=ЮгАкцент — API (NestJS)
Documentation=https://yugaktsent.neeklo.ru
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
# Не уходить в бесконечный цикл перезапусков, если падение постоянное
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/var/www/yugaktsent-lg/apps/api
# Окружение собирает write-systemd-env.mjs из .env проекта
EnvironmentFile=/etc/yugaktsent/api.env
ExecStart=/usr/bin/node dist/main.js

Restart=always
RestartSec=4

# Столько же, сколько держал PM2
MemoryMax=1G
TimeoutStopSec=10
KillMode=mixed

StandardOutput=append:/var/log/yugaktsent-lg/api-out.log
StandardError=append:/var/log/yugaktsent-lg/api-error.log
SyslogIdentifier=yugaktsent-api

[Install]
WantedBy=multi-user.target
